# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="YOUR_APP_URL"

# SQLITE_DB_PATH: Path to the persistent SQLite database file.
# Defaults to "firstround.db" in the application root directory if not specified.
SQLITE_DB_PATH="firstround.db"

# ADMIN_SECRET: Secret key required to access the admin routes.
# Must be passed in the X-Admin-Secret request header.
ADMIN_SECRET="YOUR_ADMIN_SECRET"

# Razorpay Test Mode Credentials
# RAZORPAY_KEY_ID is exposed to browser Checkout for client initialization
RAZORPAY_KEY_ID=your_test_key_id
# RAZORPAY_KEY_SECRET MUST remain server-side only. NEVER expose to browser/Vite.
RAZORPAY_KEY_SECRET=your_test_key_secret
# RAZORPAY_WEBHOOK_SECRET is used for verifying Razorpay webhook signatures server-side.
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret
